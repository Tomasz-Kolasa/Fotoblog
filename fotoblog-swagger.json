        "type": "object",
        "properties": {
          "name": {
            "maxLength": 30,
            "minLength": 3,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PhotoVm": {
        "required": [
          "createdAt",
          "id",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "maxLength": 15,
            "minLength": 2,
            "type": "string"
          },
          "description": {
            "maxLength": 30,
            "type": "string",
            "nullable": true
          },
          "originalUrl": {
            "type": "string",
            "nullable": true
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagVm"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterAdminVm": {
        "required": [
          "confirmPassword",
          "email",
          "password",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "maxLength": 20,
            "minLength": 6,
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 20,
            "minLength": 6,
            "type": "string"
          },
          "confirmPassword": {
            "maxLength": 20,
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ResetPasswordVm": {
        "required": [
          "confirmNewPwd",
          "email",
          "newPwd",
          "token"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "token": {
            "type": "string"
          },
          "newPwd": {
            "maxLength": 20,
            "minLength": 6,
            "type": "string"
          },
          "confirmNewPwd": {
            "maxLength": 20,
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "TagVm": {
        "required": [
