      "ChangePwdVm": {
        "required": [
          "confirmNewPwd",
          "newPwd",
          "oldPwd",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "oldPwd": {
            "maxLength": 20,
            "minLength": 6,
            "type": "string"
          },
          "newPwd": {
            "maxLength": 20,
            "minLength": 6,
            "type": "string"
          },
          "confirmNewPwd": {
